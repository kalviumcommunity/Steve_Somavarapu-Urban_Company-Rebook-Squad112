{
  "name": "urban-company-rebook-database",
  "version": "1.0.0",
  "description": "Urban Company One-Click Rebooking PostgreSQL Database & Prisma ORM Layer",
  "main": "index.js",
  "scripts": {
    "db:validate": "prisma validate --schema=./prisma/schema.prisma",
    "db:format": "prisma format --schema=./prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --name init_urban_company_rebook --schema=./prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:push": "prisma db push --schema=./prisma/schema.prisma",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio --schema=./prisma/schema.prisma"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts",
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@prisma/client": "^6.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "prisma": "^6.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
